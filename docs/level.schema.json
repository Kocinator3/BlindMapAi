{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slep\u00e1Mapa Level v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "language": {
      "type": "string"
    },
    "difficulty": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "unverified": {
      "type": "boolean"
    },
    "map": {
      "type": "object",
      "properties": {
        "center": {
          "$ref": "#/$defs/coordinate"
        },
        "longitudeSpan": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 160
        },
        "showCountryBorders": {
          "type": "boolean"
        }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "coordinate": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -85,
          "maximum": 85
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "prompt",
        "answerType",
        "geometry"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "answerType": {
          "enum": [
            "point",
            "polyline",
            "polygon",
            "freehandArea",
            "circle",
            "multiPoint"
          ]
        },
        "category": {
          "type": "string"
        },
        "explanation": {
          "type": "string"
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "difficulty": {
          "type": "string"
        },
        "scoring": {
          "type": "object",
          "properties": {
            "toleranceKm": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 2000
            }
          }
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "$ref": "#/$defs/coordinate"
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "MultiPoint"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/coordinate"
                  },
                  "minItems": 1,
                  "maxItems": 12
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "LineString"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/coordinate"
                  },
                  "minItems": 2,
                  "maxItems": 500
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "MultiLineString"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/coordinate"
                    },
                    "minItems": 2,
                    "maxItems": 500
                  },
                  "minItems": 1,
                  "maxItems": 20
                }
              }
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Polygon"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/coordinate"
                    },
                    "minItems": 4,
                    "maxItems": 500
                  }
                }
              }
            }
          ]
        }
      }
    }
  }
}
