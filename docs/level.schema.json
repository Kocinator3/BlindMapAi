{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slep\u00e1Mapa Level v1",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "title",
    "questions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "language": {
      "type": "string"
    },
    "difficulty": {
      "type": "string"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "unverified": {
      "type": "boolean"
    },
    "map": {
      "type": "object",
      "properties": {
        "center": {
          "$ref": "#/$defs/coordinate"
        },
        "longitudeSpan": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 160
        },
        "showCountryBorders": {
          "type": "boolean"
        },
        "showRivers": {
          "type": "boolean",
          "default": true
        },
        "showCities": {
          "type": "boolean",
          "default": true
        },
        "showLakes": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/question"
      }
    },
    "hardcoreMode": {
      "type": "boolean",
      "default": false,
      "description": "An answer below 700/1000 ends the level."
    },
    "toleranceMultiplier": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 4,
      "default": 1,
      "description": "Multiplies distance tolerance for point, multiPoint and polyline; area overlap is unchanged."
    }
  },
  "$defs": {
    "coordinate": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -85,
          "maximum": 85
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "question": {
      "type": "object",
      "required": [
        "id",
        "prompt",
        "answerType",
        "geometry"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "prompt": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "answerType": {
          "enum": [
            "point",
            "polyline",
            "polygon",
            "freehandArea",
            "circle",
            "multiPoint"
          ]
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "explanation": {
          "type": "string",
          "maxLength": 4000
        },
        "hints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "maxItems": 50
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "maxItems": 50
        },
        "difficulty": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "scoring": {
          "type": "object",
          "properties": {
            "toleranceKm": {
              "type": "number",
              "minimum": 0.1,
              "maximum": 2000
            }
          },
          "additionalProperties": false
        },
        "geometry": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Point"
                },
                "coordinates": {
                  "$ref": "#/$defs/coordinate"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "MultiPoint"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/coordinate"
                  },
                  "minItems": 1,
                  "maxItems": 12
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "LineString"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/coordinate"
                  },
                  "minItems": 2,
                  "maxItems": 500
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "MultiLineString"
                },
                "coordinates": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/coordinate"
                    },
                    "minItems": 2,
                    "maxItems": 500
                  },
                  "minItems": 1,
                  "maxItems": 250
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "type",
                "coordinates"
              ],
              "properties": {
                "type": {
                  "const": "Polygon"
                },
                "coordinates": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 1,
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/coordinate"
                    },
                    "minItems": 4,
                    "maxItems": 500
                  }
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "answerType": {
                "const": "point"
              }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "properties": {
                  "type": {
                    "enum": [
                      "Point"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answerType": {
                "const": "polyline"
              }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "properties": {
                  "type": {
                    "enum": [
                      "LineString",
                      "MultiLineString"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answerType": {
                "const": "multiPoint"
              }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "properties": {
                  "type": {
                    "enum": [
                      "MultiPoint"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answerType": {
                "const": "polygon"
              }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answerType": {
                "const": "freehandArea"
              }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon"
                    ]
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "answerType": {
                "const": "circle"
              }
            }
          },
          "then": {
            "properties": {
              "geometry": {
                "properties": {
                  "type": {
                    "enum": [
                      "Polygon"
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "additionalProperties": false
}
